ized with a mine-explosive injury, amputation of her left arm and leg, and shrapnel wounds to her torso.&quot;, &quot;adm_1&quot;: &quot;Kherson oblast&quot;, &quot;adm_2&quot;: &quot;Kherson raion&quot;, &quot;latitude&quot;: &quot;46.639950&quot;, &quot;longitude&quot;: &quot;32.503430&quot;, &quot;geom_wkt&quot;: &quot;POINT (32.50343 46.63995)&quot;, &quot;priogrid_gid&quot;: &quot;196986&quot;, &quot;country&quot;: &quot;Ukraine&quot;, &quot;country_id&quot;: &quot;369&quot;, &quot;region&quot;: &quot;Europe&quot;, &quot;event_clarity&quot;: &quot;1&quot;, &quot;date_prec&quot;: &quot;1&quot;, &quot;date_start&quot;: &quot;2026-05-10 00:00:00.000&quot;, &quot;date_end&quot;: &quot;2026-05-10 00:00:00.000&quot;, &quot;deaths_a&quot;: &quot;0&quot;, &quot;deaths_b&quot;: &quot;0&quot;, &quot;deaths_civilians&quot;: &quot;1&quot;, &quot;deaths_unknown&quot;: &quot;0&quot;, &quot;best&quot;: &quot;1&quot;, &quot;high&quot;: &quot;1&quot;, &quot;low&quot;: &quot;1&quot;, &quot;gwnoa&quot;: &quot;365&quot;, &quot;gwnob&quot;: &quot;369&quot;, &quot;_source&quot;: &quot;ucdp-candidate-ged-2026-06&quot;, &quot;headline_method_indicators&quot;: [&quot;Drone&quot;]}</data><data key="k16">169.52259457902574</data><data key="k17">14.022269257951598</data><data key="k18">-188.79022969242976</data></node><node id="event:630184"><data key="k8">event</data><data key="k9">630184 / 2026-05-10</data><data key="k10">true</data><data key="k11">2</data><data key="k12">0.0007176175098672408</data><data key="k13">0.0007554817503376228</data><data key="k14">2026-05-10</data><data key="k15">{&quot;id&quot;: &quot;630184&quot;, &quot;relid&quot;: &quot;UKR-2026-1-14117-1127&quot;, &quot;year&quot;: &quot;2026&quot;, &quot;active_year&quot;: &quot;true&quot;, &quot;code_status&quot;: &quot;Clear&quot;, &quot;type_of_violence&quot;: &quot;1&quot;, &quot;conflict_dset_id&quot;: &quot;&quot;, &quot;conflict_new_id&quot;: &quot;13243&quot;, &quot;conflict_name&quot;: &quot;Russia - Ukraine&qu